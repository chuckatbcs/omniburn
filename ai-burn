def cmd_status(args):
    conn = get_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM subscriptions")
    subs = cursor.fetchall()
    
    cursor.execute("SELECT * FROM quota_pools")
    pools = cursor.fetchall()

    cursor.execute("SELECT COUNT(*) as cnt FROM models WHERE is_active = 1")
    active_models = cursor.fetchone()["cnt"]

    cursor.execute("SELECT COUNT(*) as cnt FROM models")
    total_models = cursor.fetchone()["cnt"]

    cursor.execute("SELECT * FROM model_changelog ORDER BY id DESC LIMIT 5")
    changes = cursor.fetchall()
    conn.close()

    active_spend = sum(s["monthly_cost"] for s in subs if s["status"] == "active")
    total_spend = sum(s["monthly_cost"] for s in subs)
    daily_burn = active_spend / 30.416

    print("\n==========================================================================")
    print("        OMNIBURN [Built by AGY] — AI SUBSCRIPTION BURN STATUS             ")
    print("==========================================================================")
    print(f"Active Monthly Spend:     ${active_spend:.2f}/mo  (${daily_burn:.2f}/day) [Total Configured: ${total_spend:.2f}/mo]")
    print(f"Tracked Models:           {active_models} active / {total_models} total models")
    print("--------------------------------------------------------------------------")
    print(f"{'Subscription':<32} | {'Provider':<10} | {'Cost/mo':<8} | {'Status'}")
    print("--------------------------------------------------------------------------")
    for s in subs:
        status_badge = "[ACTIVE]" if s["status"] == "active" else "[DISABLED]"
        print(f"{s['name']:<32} | {s['provider']:<10} | ${s['monthly_cost']:>6.2f} | {status_badge}")

    print("\n--------------------------------------------------------------------------")
    print(f"{'Quota Pool':<28} | {'Type':<15} | {'Current 5h':<10} | {'Weekly Ceiling'}")
    print("--------------------------------------------------------------------------")
    for p in pools:
        is_5h = "rolling_5h" in p["window_type"]
        cur = f"{p['current_pct_remaining']}%"
        wk = f"{p['weekly_pct_remaining']}%" if is_5h else "N/A"
        print(f"{p['pool_name']:<28} | {p['window_type']:<15} | {cur:<10} | {wk}")

    if changes:
        print("\n--------------------------------------------------------------------------")
        print("Recent Model & Pricing Radar:")
        for c in changes:
            print(f" • [{c['event_type']}] {c['details']} ({c['timestamp'][:19]})")
    print("==========================================================================\n")

def cmd_sync(args):
    print("Running live model registry & pricing sync...")
    res = sync_models()
    print(f"✓ Sync Complete! Local models scanned: {res['local_agy_models_synced']}, OpenRouter scanned: {res['openrouter_models_scanned']}")
    if res["changes"]:
        print(f"Detected {len(res['changes'])} new changes:")
