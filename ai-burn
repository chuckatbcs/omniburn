def cmd_classify(args):
    prompt = " ".join(args.prompt) if args.prompt else None
    c = classify_workload(prompt=prompt, repo_path=args.dir)
    print("\n==========================================================================")
    print("      OMNIBURN [Built by AGY] — WORKLOAD COMPLEXITY CLASSIFICATION         ")
    print("==========================================================================")
    print(f"Detected Tier:        Tier {c['tier_id']} ({c['tier_label']})")
    print(f"Confidence Score:     {c['confidence'] * 100:.0f}%")
    print(f"Estimated Footprint:  ~{c['estimated_tokens']:,} billable tokens")
    print(f"Identified Intent:    {c['intent']}")
    print(f"Suggested Strategy:   {c['recommended_strategy'].upper()}")
    if c.get("prompt_summary"):
        print(f"Prompt Evaluated:     \"{c['prompt_summary']}\"")
    ws = c["workspace_stats"]
    if ws.get("is_git_repo"):
        print(f"Workspace Git State:  {ws['file_count']} files modified (+{ws['additions']}/-{ws['deletions']} lines)")
        if ws["modified_files"]:
            print(f"Modified Files:       {', '.join(ws['modified_files'][:5])}{' ...' if len(ws['modified_files']) > 5 else ''}")
    else:
        print("Workspace Git State:  No active git repository detected (classified on prompt heuristics)")
    if c["signals"]:
        print("Signals & Rationale:")
        for s in c["signals"]:
            print(f" • {s}")
    print("==========================================================================\n")

def cmd_route(args):
    prompt = " ".join(args.prompt) if args.prompt else None
    c = classify_workload(prompt=prompt, repo_path=args.dir)
    tier_id = c["tier_id"]
    strat = (
        ("quota_first" if args.strategy == "quota" else "time_reliability_first")
        if args.strategy
        else c["recommended_strategy"]
    )
    rec = recommend(tier_id=tier_id, strategy=strat, plan_filter=args.plan)
    top = rec["top_recommendation"]
    runner = rec["runner_up"]

    print("\n==========================================================================")
    print("       OMNIBURN [Built by AGY] — CONTEXT-AWARE SMART AUTO-ROUTER          ")
    print("==========================================================================")
    print(f"Task Analyzed:    {c['prompt_summary'] or 'Current git workspace'}")
    print(f"Auto-Classified:  Tier {tier_id} ({c['intent']}) [Confidence: {c['confidence']*100:.0f}% | ~{c['estimated_tokens']:,} tokens]")
    print(f"Active Strategy:  {strat.upper()}")
    print("--------------------------------------------------------------------------")
    if not top:
        print("⚠️  NO ACTIVE MODELS AVAILABLE!")
        print("   " + rec.get("error", "All candidate models are disabled."))
        print("==========================================================================\n")
        return

    print(f"🏆 TOP CHOICE:    {top['display_name']}")
    print(f"   Provider/Sub:  {top['provider']} ({top['sub_name'] or 'API'})")
    print(f"   Harness/Pool:  {top['harness']} ({top['pool_name'] or 'Default Pool'})")
    print(f"   Tasks/Pool:    {top['tasks_per_pool_cycle']} tasks per reset window")
    print(f"   Sub Cost/Task: ${top['cost_per_completed_task']} per completed task")
    print(f"   Success-Adj:   {top['success_adjusted_seconds']}s | {top['success_adjusted_tokens']:,} tokens")
    if top.get("recommendation_notes"):
        print(f"   Notes:         {top['recommendation_notes']}")

    if runner:
        print(f"\n🥈 RUNNER UP:     {runner['display_name']}")
        print(f"   Provider/Sub:  {runner['provider']} ({runner['sub_name'] or 'API'})")
        print(f"   Harness/Pool:  {runner['harness']} ({runner['pool_name'] or 'Default Pool'})")
        print(f"   Tasks/Pool:    {runner['tasks_per_pool_cycle']} tasks")
        print(f"   Sub Cost/Task: ${runner['cost_per_completed_task']}")
        print(f"   Success-Adj:   {runner['success_adjusted_seconds']}s | {runner['success_adjusted_tokens']:,} tokens")

    if rec.get("rationale"):
        print("\n💡 Policy Guidance:")
        for r in rec["rationale"]:
            print(f" • {r}")
    print("==========================================================================\n")

def cmd_benchmark(args):
    print("\n==========================================================================")
    print("       OMNIBURN [Built by AGY] — LOCAL GOLDEN TASK VERIFICATION HARNESS   ")
    print("==========================================================================")
    if args.tier:
        print(f"Running Golden Benchmark Suite for Tier {args.tier}...")
        results = [run_golden_suite(args.tier, model_id=args.model)]
    else:
        print("Running Golden Benchmark Suite across all Tiers 1-4...")
        results = run_all_benchmarks(model_id=args.model)

    print("--------------------------------------------------------------------------")
    print(f"{'Task / Suite':<36} | {'Tier':<6} | {'Model':<24} | {'Measured':<10} | {'Tokens':<8} | {'Status'}")
    print("--------------------------------------------------------------------------")
    for r in results:
        status_badge = "[PASSED]" if r["status"] == "passed" else "[FAILED]"
        print(f"{r['task_name']:<36} | Tier {r['tier_id']} | {r['model_id']:<24} | {r['execution_sec']:>7.1f}s   | {r['tokens_evaluated']:>6}   | {status_badge}")
    print("--------------------------------------------------------------------------")
    print("✓ Local execution verified and empirical telemetry recorded to burn_tracker.db.")
    print("==========================================================================\n")

def cmd_serve(args):
    run_server(port=args.port)

def main():
    parser = argparse.ArgumentParser(description="OmniBurn: AI Subscription Burn & Yield Engine")
    subparsers = parser.add_subparsers(dest="command")

    # status
    subparsers.add_parser("status", help="Show current subscription burn and quota status")

    # sync
    subparsers.add_parser("sync", help="Sync models and prices from live feeds")

    # recommend
    rec_parser = subparsers.add_parser("recommend", help="Get optimal model routing recommendation")
    rec_parser.add_argument("--tier", type=int, choices=[1, 2, 3, 4], default=2, help="Task complexity tier (1-4)")
    rec_parser.add_argument("--strategy", choices=["quota", "time"], default="quota", help="Routing strategy priority")
    rec_parser.add_argument("--plan", choices=["all", "gemini", "claude", "cursor", "chatgpt"], default="all", help="Filter by plan")

    # enable / disable
    en_parser = subparsers.add_parser("enable", help="Enable a model or provider")
    en_parser.add_argument("--model", help="Model ID to enable")
    en_parser.add_argument("--provider", help="Provider/Subscription to enable")

    dis_parser = subparsers.add_parser("disable", help="Disable a model or provider")
    dis_parser.add_argument("--model", help="Model ID to disable")
    dis_parser.add_argument("--provider", help="Provider/Subscription to disable")

    # models with sorting
    mod_parser = subparsers.add_parser("models", help="List all tracked models with cost and sorting")
    mod_parser.add_argument("--sort", choices=["default", "cost", "api-cost", "tasks", "latency", "tokens", "name"], default="default", help="Sort order")
    mod_parser.add_argument("--tier", type=int, choices=[1, 2, 3, 4], default=2, help="Filter by tier (1-4)")
    mod_parser.add_argument("--provider", help="Filter by provider (e.g. OpenAI, Google, Anthropic, Cursor, xAI)")

    # log
    log_parser = subparsers.add_parser("log", help="Log task execution and decrement quota")
    log_parser.add_argument("--model", required=True, help="Model ID used")
    log_parser.add_argument("--tier", type=int, choices=[1, 2, 3, 4], default=2, help="Task complexity tier")
    log_parser.add_argument("--sec", type=float, default=60.0, help="Wall-clock duration in seconds")
    log_parser.add_argument("--dec5h", type=int, default=0, help="Visible 5h percentage decrement observed")
    log_parser.add_argument("--failed", action="store_true", help="Flag if task failed completely")
    log_parser.add_argument("--retried", action="store_true", help="Flag if task required retries")
    log_parser.add_argument("--desc", default="CLI task run", help="Description")

    # telemetry
    subparsers.add_parser("telemetry", help="View audited empirical matched telemetry")

    # classify
    cls_parser = subparsers.add_parser("classify", help="Auto-classify coding task complexity tier (RouteLLM style)")
    cls_parser.add_argument("prompt", nargs="*", help="Optional task description or instructions")
    cls_parser.add_argument("--dir", default=None, help="Working directory to inspect git status and diff")

    # route
    route_parser = subparsers.add_parser("route", help="Auto-classify task complexity and route to optimal model")
    route_parser.add_argument("prompt", nargs="*", help="Optional task description or instructions")
    route_parser.add_argument("--dir", default=None, help="Working directory to inspect git status and diff")
    route_parser.add_argument("--strategy", choices=["quota", "time"], default=None, help="Override routing strategy")
    route_parser.add_argument("--plan", choices=["all", "gemini", "claude", "cursor", "chatgpt"], default="all", help="Filter by plan")

    # benchmark
    bm_parser = subparsers.add_parser("benchmark", help="Run local Golden Task Verification Harness (Aider/SWE-bench style)")
    bm_parser.add_argument("--tier", type=int, choices=[1, 2, 3, 4], default=None, help="Specific tier to benchmark (1-4, default all)")
    bm_parser.add_argument("--model", default=None, help="Model ID to evaluate")

    # serve
    serve_parser = subparsers.add_parser("serve", help="Run local web server on port 8787")
    serve_parser.add_argument("--port", type=int, default=8787, help="Port to listen on")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    if args.command == "status":
        cmd_status(args)
    elif args.command == "sync":
        cmd_sync(args)
    elif args.command == "recommend":
        cmd_recommend(args)
    elif args.command == "classify":
        cmd_classify(args)
    elif args.command == "route":
        cmd_route(args)
    elif args.command == "benchmark":
        cmd_benchmark(args)
    elif args.command == "enable":
        cmd_enable(args)
    elif args.command == "disable":
        cmd_disable(args)
    elif args.command == "models":
        cmd_models(args)
    elif args.command == "log":
        cmd_log(args)
    elif args.command == "telemetry":
        cmd_telemetry(args)
    elif args.command == "serve":
        cmd_serve(args)

if __name__ == "__main__":
    main()
