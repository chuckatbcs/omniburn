def cmd_recommend(args):
    strat = "quota_first" if args.strategy == "quota" else "time_reliability_first"
    rec = recommend(tier_id=args.tier, strategy=strat, plan_filter=args.plan)
    
    top = rec["top_recommendation"]
    runner = rec["runner_up"]
    
    print("\n==========================================================================")
    print(f" OMNIBURN [Built by AGY] ROUTING RECOMMENDATION (Tier {args.tier} | {strat.upper()})")
    print("==========================================================================")
    if not top:
        print("⚠️  NO ACTIVE MODELS AVAILABLE!")
        print("   " + rec.get("error", "All candidate models are disabled."))
        print("   Run `ai-burn enable --model <id>` or `ai-burn enable --provider <name>`.")
        print("==========================================================================\n")
        return

    print(f"🏆 TOP CHOICE:    {top['display_name']}")
    print(f"   Harness/Pool:  {top['harness']} ({top['pool_name'] or 'Default'})")
    print(f"   Tasks/Pool:    {top['tasks_per_pool_cycle']} tasks per 100% reset cycle")
    print(f"   Sub Cost/Task: ${top['cost_per_completed_task']} per completed task")
    print(f"   Success-Adj:   {top['success_adjusted_seconds']}s | {top['success_adjusted_tokens']:,} tokens per completed task")
    print(f"   Notes:         {top['recommendation_notes']}")

    if runner:
        print(f"\n🥈 RUNNER UP:     {runner['display_name']}")
        print(f"   Harness/Pool:  {runner['harness']}")
        print(f"   Tasks/Pool:    {runner['tasks_per_pool_cycle']} tasks")
        print(f"   Sub Cost/Task: ${runner['cost_per_completed_task']}")
        print(f"   Success-Adj:   {runner['success_adjusted_seconds']}s | {runner['success_adjusted_tokens']:,} tokens")

    print("\n💡 Policy Guidance:")
    for r in rec["rationale"]:
        print(f" • {r}")
    print("==========================================================================\n")

def cmd_enable(args):
    if args.model:
        res = toggle_model(args.model, is_active=True)
        if "error" in res:
            print(f"Error: {res['error']}")
        else:
            print(f"✓ Model '{res['display_name']}' ({args.model}) ENABLED.")
    elif args.provider:
        res = toggle_provider(args.provider, is_active=True)
        if "error" in res:
            print(f"Error: {res['error']}")
        else:
            print(f"✓ Provider/Subscription '{res['name']}' ENABLED ({res['models_affected']} models enabled).")
    else:
        print("Specify either --model <id> or --provider <name>.")

def cmd_disable(args):
    if args.model:
        res = toggle_model(args.model, is_active=False)
        if "error" in res:
            print(f"Error: {res['error']}")
        else:
            print(f"✓ Model '{res['display_name']}' ({args.model}) DISABLED.")
    elif args.provider:
        res = toggle_provider(args.provider, is_active=False)
        if "error" in res:
            print(f"Error: {res['error']}")
        else:
            print(f"✓ Provider/Subscription '{res['name']}' DISABLED ({res['models_affected']} models disabled).")
    else:
        print("Specify either --model <id> or --provider <name>.")

def cmd_models(args):
    conn = get_connection()
    cursor = conn.cursor()

    sort_order = "m.is_active DESC, y.tier_id ASC, y.quota_first_score DESC"
    if args.sort == "cost":
        sort_order = "m.is_active DESC, y.cost_per_completed_task ASC"
    elif args.sort == "api-cost":
        sort_order = "m.is_active DESC, y.api_cost_per_task ASC"
    elif args.sort == "tasks":
        sort_order = "m.is_active DESC, y.tasks_per_pool_cycle DESC"
    elif args.sort == "latency":
        sort_order = "m.is_active DESC, y.success_adjusted_seconds ASC"
    elif args.sort == "tokens":
        sort_order = "m.is_active DESC, y.success_adjusted_tokens ASC"
    elif args.sort == "name":
        sort_order = "m.is_active DESC, m.display_name ASC"

    filters = []
    if args.tier:
        filters.append(f"y.tier_id = {args.tier}")
    if args.provider:
        filters.append(f"LOWER(m.provider) LIKE '%{args.provider.lower()}%'")

    where_clause = f"WHERE {' AND '.join(filters)}" if filters else ""

    cursor.execute(f"""
        SELECT m.model_id, m.display_name, m.provider, m.harness, m.is_active,
               m.input_cost_per_m, m.output_cost_per_m,
               y.tier_id, y.tasks_per_pool_cycle, y.cost_per_completed_task,
               y.api_cost_per_task, y.success_adjusted_seconds
        FROM models m
        JOIN model_task_yields y ON m.model_id = y.model_id
        {where_clause}
        ORDER BY {sort_order}
    """)
    rows = cursor.fetchall()
    conn.close()

    print("\n=================================================================================================================================")
    sort_label = f"SORTED BY: {args.sort.upper()}"
    tier_label = f" (TIER {args.tier})" if args.tier else " (ALL TIERS)"
    print(f"                               OMNIBURN TRACKED MODELS & COSTS — {sort_label}{tier_label}                          ")
    print("=================================================================================================================================")
    print(f"{'Model Name':<28} | {'Provider':<13} | {'Harness / Route':<22} | {'Tier':<6} | {'Sub Cost/Task':<14} | {'Raw API Cost':<13} | {'Status'}")
    print("---------------------------------------------------------------------------------------------------------------------------------")
    for r in rows:
        st = "ACTIVE" if r["is_active"] else "OFF"
        print(f"{r['display_name']:<28} | {r['provider']:<13} | {r['harness']:<22} | Tier {r['tier_id']} | ${r['cost_per_completed_task']:>11.4f}  | ${r['api_cost_per_task']:>10.4f}  | [{st}]")
    print("=================================================================================================================================\n")

def cmd_log(args):
    res = log_task_run(
        task_id=f"CLI-{os.urandom(4).hex()}",
        model_id=args.model,
        task_class=f"Tier {args.tier}",
        completed=not args.failed,
        first_pass_success=not args.retried,
        wall_clock_seconds=args.sec,
        dec_5h=args.dec5h,
        description=args.desc
    )
    print(f"✓ Task logged. Remaining 5h quota for pool: {res['pool_5h_remaining']}%")

